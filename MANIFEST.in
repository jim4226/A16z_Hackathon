include LICENSE README.md requirements.txt requirements.lock
include CHANGELOG.md SECURITY.md env.example
include run_studio.bat run_studio.sh setup_studio.bat setup_studio.sh
recursive-include robots *
recursive-include data/darwin-cache *.json
recursive-include morph/studio/static *
include morph/robot/time_baseline.json
include tools/install_local.py tools/build_release.py tools/package_smoke.py tools/run_offline_tests.py
include tools/browser_smoke.cjs tools/keewano_backfill.py
recursive-include docs *.md
recursive-include .github/workflows *.yml
recursive-include tests *.py *.h
global-exclude __pycache__ *.py[cod]
