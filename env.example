# The first launch copies this file to .env (same folder, git-ignored). Add keys there, or with the
# Keys button in Morph Studio (top right). All are optional. Morph reads .env every time it starts;
# keys already set in the terminal win.

# Claude, for the design chat (without it the suggestion chips and simple requests still work offline)
ANTHROPIC_API_KEY=

# Keewano build memory (see docs/INTEGRATIONS.md, "Keys")
KEEWANO_API_KEY=
KEEWANO_PAT=
KEEWANO_PROJECT_ID=

# SubQ Snap (Subquadratic), console.subq.ai: quick decisions about a request, shown as "SubQ Snap (AI)". Requests
# go to SubQ under your own account; it keeps them per your organisation's retention setting and doesn't train on them.
SUBQ_API_KEY=

# Tool keys (beta): when one of Morph's agent tools needs your own key, the Keys dialog lists it under the tool's
# service, with where to get it, what it costs and what is sent. These keys are named MORPH_TOOL_<NAME> (the dialog shows
# each exact name), must fit the pattern the tool's manifest gives, and are sent only to that tool's own hosts, never to
# Claude. Add them in the Keys dialog, or here, one per line: MORPH_TOOL_<NAME>=<key>

# Bring your own compute (--remote): a fixed access code instead of a new one each start (8 to 128 letters, digits,
# - or _). It goes in the access link, so treat it like a password.
MORPH_TOKEN=
