# Copy this file to .env (same folder) and fill in what you have. .env is git-ignored.
# Morph reads it every time it starts; keys already set in the terminal win.

# Claude, for the design chat (without it the suggestion chips and simple requests still work offline)
ANTHROPIC_API_KEY=

# Keewano build memory (see docs/SPONSORS.md, "Keys")
KEEWANO_API_KEY=
KEEWANO_PAT=
KEEWANO_PROJECT_ID=
