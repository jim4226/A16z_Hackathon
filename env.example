# Developer-only: copy to .env and set MORPH_LOAD_DOTENV=1 before using the CLI.
# .env is git-ignored but plaintext. End users should connect Claude in Studio Settings.
# Keys already set in the terminal win. Credentials alone never enable telemetry.

# Claude, for the design chat (without it the suggestion chips and simple requests still work offline)
ANTHROPIC_API_KEY=

# Keewano build memory (see docs/SPONSORS.md, "Keys")
KEEWANO_API_KEY=
KEEWANO_PAT=
KEEWANO_PROJECT_ID=
