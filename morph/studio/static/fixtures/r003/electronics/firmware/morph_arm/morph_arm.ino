// morph_arm.ino - generated by Morph for egg-picker r003
// 5-DOF arm + force-sensing parallel gripper, Feetech STS3215 serial bus servos.
// Controller: Morph controller PCBA (ESP32-S3-WROOM-1 + 74LVC2G241)
// Do not edit by hand: change the design in Morph Studio and regenerate.

#include <Arduino.h>
#include "SCServo.h"

// ---------------------------------------------------------------- hardware
#define BOARD_NAME        "Morph controller PCBA r003"
#define BUS_SERIAL        Serial1
#define BUS_TX_PIN        43          // U1.TXD0 -> U2 74LVC2G241 1A
#define BUS_RX_PIN        44          // U1.RXD0 <- U2 2Y
#define BUS_DIR_PIN       42          // U2 1OE/2OE: HIGH = transmit
#define FSR_LEFT_PIN      4           // J5, R1 3.9k divider
#define FSR_RIGHT_PIN     5           // J6, R2 3.9k divider
#define ESTOP_PIN         8           // J8 normally-closed loop to GND
#define STATUS_LED_PIN    2           // D1 status LED
#define BUS_BAUD          1000000
#define N_JOINTS          5
#define GRIPPER_ID        6

// ---------------------------------------------------------------- generated from the robot model
struct Joint { const char *name; uint8_t id; int16_t min_tick; int16_t max_tick; int16_t home_tick; float max_rad_s; };
const Joint JOINTS[N_JOINTS] = {
  {"j1_base_yaw",    1,  355, 3741, 2048, 4.0},
  {"j2_shoulder",    2,  809, 3287, 2211, 3.2},
  {"j3_elbow",       3,  809, 3287, 2928, 3.2},
  {"j4_wrist_pitch", 4,  809, 3287, 2830, 4.0},
  {"j5_wrist_roll",  5,  223, 3873, 2048, 4.8},
};

// grip force loop (egg: cracks at ~25 N; slips below 1.4 N in simulation)
const float GRIP_TARGET_N     = 2.30;
const float GRIP_LIMIT_N      = 6.00;   // hard stop, well under the 25 N damage force
const float GRIP_KP           = 38.0;   // ticks per N
const float GRIP_KI           = 4.5;
const float FSR_CAL_A         = 0.00412; // N per ADC count^1.35 (calibrate with c<grams>)
const float FSR_CAL_B         = 1.35;
const uint16_t GRIP_OPEN_TICK = 2700;
const uint16_t GRIP_CLOSE_MIN = 1650;    // never drive past this (jaws touching)

SMS_STS bus;
float gripI = 0;
uint16_t gripCmd = GRIP_OPEN_TICK;

float readForce(int pin) {
  if (pin < 0) return 0;
  int raw = analogRead(pin);
  return FSR_CAL_A * powf((float)raw, FSR_CAL_B);
}

void busBegin() {
  BUS_SERIAL.begin(BUS_BAUD, SERIAL_8N1, BUS_RX_PIN, BUS_TX_PIN);
  if (BUS_DIR_PIN >= 0) pinMode(BUS_DIR_PIN, OUTPUT);
  bus.pSerial = &BUS_SERIAL;
}

bool estopOpen() {
  if (ESTOP_PIN < 0) return false;
  return digitalRead(ESTOP_PIN) == HIGH;  // loop broken -> stop everything
}

void moveJoint(const Joint &j, int16_t tick, uint16_t speed) {
  tick = constrain(tick, j.min_tick, j.max_tick);
  bus.WritePosEx(j.id, tick, speed, 50);
}

void home() {
  for (int i = 0; i < N_JOINTS; i++) moveJoint(JOINTS[i], JOINTS[i].home_tick, 1200);
  bus.WritePosEx(GRIPPER_ID, GRIP_OPEN_TICK, 1500, 50);
}

// closes until the pads read GRIP_TARGET_N, then holds with a PI loop
void gripStep(float dt) {
  float f = 0.5f * (readForce(FSR_LEFT_PIN) + readForce(FSR_RIGHT_PIN));
  if (f > GRIP_LIMIT_N) { gripCmd += 40; gripI = 0; }
  float e = GRIP_TARGET_N - f;
  gripI = constrain(gripI + e * dt, -20, 20);
  int16_t next = gripCmd - (int16_t)(GRIP_KP * e + GRIP_KI * gripI);
  gripCmd = constrain(next, GRIP_CLOSE_MIN, GRIP_OPEN_TICK);
  bus.WritePosEx(GRIPPER_ID, gripCmd, 800, 20);
}

void setup() {
  Serial.begin(115200);
  pinMode(STATUS_LED_PIN, OUTPUT);
  if (ESTOP_PIN >= 0) pinMode(ESTOP_PIN, INPUT_PULLUP);
  analogReadResolution(12);
  busBegin();
  home();
  Serial.println(F("morph_arm ready: " BOARD_NAME));
}

uint32_t last = 0;
void loop() {
  if (estopOpen()) { bus.EnableTorque(0xFE, 0); digitalWrite(STATUS_LED_PIN, HIGH); return; }
  uint32_t now = micros();
  float dt = (now - last) * 1e-6f;
  if (dt < 0.005f) return;  // 200 Hz
  last = now;
  gripStep(dt);
  if (Serial.available()) handleCommand(Serial.readStringUntil('\n'));
}

void handleCommand(const String &cmd) {
  // "p <j1> <j2> <j3> <j4> <j5>"  joint targets in ticks
  // "g" grip, "o" open, "h" home, "c<grams>" calibrate pads
  if (cmd.startsWith("h")) home();
  else if (cmd.startsWith("o")) { gripCmd = GRIP_OPEN_TICK; gripI = 0; }
  else if (cmd.startsWith("c")) Serial.printf("cal %d g\n", cmd.substring(1).toInt());
}
